{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": [
    "before 6am on monday"
  ],
  "packageRules": [
    {
      "description": "Compose BOM をやめて個別バージョン管理にしたため、androidx.compose.* は1つのPRにまとめる (#20)",
      "matchPackageNames": [
        "androidx.compose.ui:**",
        "androidx.compose.foundation:**",
        "androidx.compose.material3:**"
      ],
      "groupName": "androidx compose"
    },
    {
      "description": "ビルドの JDK は gradle/gradle-daemon-jvm.properties で固定し、Android Studio 同梱の JBR に合わせて上げる。CI の setup-java だけをメジャー更新しても実際のビルド JDK は変わらないため無視する",
      "matchPackageNames": [
        "java-jdk"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    }
  ]
}
